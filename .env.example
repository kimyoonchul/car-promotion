# Claude API — 배너 이미지에서 기간·혜택 추출 (비우면 이미지 추출 생략)
ANTHROPIC_API_KEY=
# 기본 claude-opus-4-8. 비용을 줄이려면 claude-haiku-4-5 로 교체 가능
VISION_MODEL=

# 디스코드 웹훅 — 신규 캠페인 알림 (비우면 알림 생략)
DISCORD_WEBHOOK_URL=

# 구글 시트 — 캠페인 축적 (비우면 시트 기록 생략)
GOOGLE_SHEET_ID=
# 서비스 계정 JSON 파일 내용을 한 줄로 통째로 넣기
GOOGLE_SERVICE_ACCOUNT_JSON=
